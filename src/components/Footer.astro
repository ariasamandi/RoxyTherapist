---
import { site } from '../config/site.ts';

const year = new Date().getFullYear();
---

<footer class="surface-footer border-t border-sage/15">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="font-heading text-2xl text-text">{site.name}</p>
        <p class="mt-2 max-w-sm text-sm text-text-muted">{site.description}</p>
      </div>

      <div>
        <p class="mb-3 text-sm font-medium text-text">Quick Links</p>
        <ul class="space-y-2">
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-text-muted transition-colors hover:text-terracotta">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="mb-3 text-sm font-medium text-text">Contact</p>
        <ul class="space-y-2 text-sm text-text-muted">
          <li>
            <a href={`tel:${site.contact.phoneHref}`} class="hover:text-terracotta">
              {site.contact.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.contact.email}`} class="hover:text-terracotta">
              {site.contact.email}
            </a>
          </li>
          <li>{site.contact.location}</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-sage/15 pt-6 text-center text-sm text-text-muted">
      <p>&copy; {year} {site.title}. All rights reserved.</p>
      <p class="mt-2">
        <a href="/privacy" class="transition-colors hover:text-terracotta">Privacy Policy</a>
      </p>
    </div>
  </div>
</footer>
