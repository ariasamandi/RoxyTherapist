---
/**
 * Decorative wildflower background — soft, hand-drawn style.
 * Sits behind all page content; hidden from screen readers.
 */
---

<div class="floral-bg pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
  <!-- Bottom left cluster -->
  <svg
    class="floral-bg__flower floral-bg__flower--1"
    viewBox="0 0 120 280"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M58 280C58 220 52 180 48 140C44 100 42 60 58 20"
      stroke="#7a9168"
      stroke-width="1.5"
      stroke-linecap="round"
      opacity="0.5"></path>
    <path
      d="M48 200C38 195 32 188 28 178M48 160C56 158 62 152 66 144M52 120C42 118 36 112 34 104"
      stroke="#9caf88"
      stroke-width="1.2"
      stroke-linecap="round"
      opacity="0.45"></path>
    <ellipse cx="28" cy="178" rx="8" ry="4" fill="#9caf88" opacity="0.35" transform="rotate(-30 28 178)"
    ></ellipse>
    <ellipse cx="66" cy="144" rx="7" ry="3.5" fill="#9caf88" opacity="0.35" transform="rotate(25 66 144)"
    ></ellipse>
    <circle cx="58" cy="18" r="10" fill="#e8b4b8" opacity="0.55"></circle>
    <circle cx="58" cy="18" r="6" fill="#f5d0d4" opacity="0.7"></circle>
    <circle cx="52" cy="14" r="4" fill="#e8b4b8" opacity="0.45"></circle>
    <circle cx="64" cy="14" r="4" fill="#e8b4b8" opacity="0.45"></circle>
    <circle cx="50" cy="22" r="4" fill="#e8b4b8" opacity="0.45"></circle>
    <circle cx="66" cy="22" r="4" fill="#e8b4b8" opacity="0.45"></circle>
    <circle cx="58" cy="24" r="3.5" fill="#e8b4b8" opacity="0.4"></circle>
  </svg>

  <!-- Top right lavender -->
  <svg
    class="floral-bg__flower floral-bg__flower--2"
    viewBox="0 0 80 240"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M40 240C40 200 38 160 40 120C42 80 40 40 40 8"
      stroke="#7a9168"
      stroke-width="1.5"
      stroke-linecap="round"
      opacity="0.5"></path>
    <ellipse cx="40" cy="30" rx="5" ry="8" fill="#c9a0dc" opacity="0.5"></ellipse>
    <ellipse cx="40" cy="48" rx="5" ry="8" fill="#c9a0dc" opacity="0.45"></ellipse>
    <ellipse cx="40" cy="66" rx="5" ry="8" fill="#c9a0dc" opacity="0.5"></ellipse>
    <ellipse cx="40" cy="84" rx="5" ry="8" fill="#c9a0dc" opacity="0.45"></ellipse>
    <ellipse cx="40" cy="102" rx="4.5" ry="7" fill="#c9a0dc" opacity="0.4"></ellipse>
    <path
      d="M40 110C34 108 30 104 28 98M40 70C46 68 50 64 52 58"
      stroke="#9caf88"
      stroke-width="1"
      stroke-linecap="round"
      opacity="0.4"></path>
    <ellipse cx="28" cy="98" rx="6" ry="3" fill="#9caf88" opacity="0.3" transform="rotate(-20 28 98)"
    ></ellipse>
  </svg>

  <!-- Top left small yellow blossom -->
  <svg
    class="floral-bg__flower floral-bg__flower--3"
    viewBox="0 0 100 200"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M50 200C50 160 48 120 50 80C52 50 50 30 50 12"
      stroke="#7a9168"
      stroke-width="1.3"
      stroke-linecap="round"
      opacity="0.45"></path>
    <path d="M50 100C42 98 36 92 34 84M50 60C58 58 64 52 66 44" stroke="#9caf88" stroke-width="1" stroke-linecap="round" opacity="0.4"
    ></path>
    <circle cx="50" cy="10" r="8" fill="#e8d5a3" opacity="0.55"></circle>
    <circle cx="50" cy="10" r="4" fill="#f0e6c8" opacity="0.7"></circle>
    <circle cx="46" cy="8" r="2.5" fill="#e8d5a3" opacity="0.5"></circle>
    <circle cx="54" cy="8" r="2.5" fill="#e8d5a3" opacity="0.5"></circle>
    <circle cx="50" cy="14" r="2.5" fill="#e8d5a3" opacity="0.5"></circle>
  </svg>

  <!-- Right bottom blue wildflower -->
  <svg
    class="floral-bg__flower floral-bg__flower--4"
    viewBox="0 0 110 260"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M55 260C55 210 50 170 52 130C54 90 50 50 55 15"
      stroke="#7a9168"
      stroke-width="1.5"
      stroke-linecap="round"
      opacity="0.5"></path>
    <path
      d="M52 180C44 176 38 168 36 158M54 140C62 138 68 132 70 124M50 100C40 98 34 90 32 80"
      stroke="#9caf88"
      stroke-width="1.2"
      stroke-linecap="round"
      opacity="0.4"></path>
    <ellipse cx="36" cy="158" rx="7" ry="3.5" fill="#9caf88" opacity="0.3" transform="rotate(-25 36 158)"
    ></ellipse>
    <circle cx="55" cy="12" r="9" fill="#8fa4b8" opacity="0.5"></circle>
    <circle cx="55" cy="12" r="5" fill="#b8c9d9" opacity="0.6"></circle>
    <circle cx="49" cy="9" r="3.5" fill="#8fa4b8" opacity="0.4"></circle>
    <circle cx="61" cy="9" r="3.5" fill="#8fa4b8" opacity="0.4"></circle>
    <circle cx="52" cy="16" r="3.5" fill="#8fa4b8" opacity="0.4"></circle>
    <circle cx="58" cy="16" r="3.5" fill="#8fa4b8" opacity="0.4"></circle>
  </svg>

  <!-- Left center delicate sprig -->
  <svg
    class="floral-bg__flower floral-bg__flower--5"
    viewBox="0 0 90 180"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M45 180C45 140 42 100 45 60C48 35 44 20 45 8"
      stroke="#7a9168"
      stroke-width="1.2"
      stroke-linecap="round"
      opacity="0.4"></path>
    <circle cx="38" cy="50" r="2" fill="#c9a0dc" opacity="0.45"></circle>
    <circle cx="42" cy="44" r="1.5" fill="#c9a0dc" opacity="0.4"></circle>
    <circle cx="48" cy="48" r="2" fill="#c9a0dc" opacity="0.45"></circle>
    <circle cx="44" cy="54" r="1.5" fill="#c9a0dc" opacity="0.4"></circle>
    <circle cx="40" cy="52" r="1.5" fill="#e8b4b8" opacity="0.4"></circle>
    <circle cx="46" cy="42" r="1.5" fill="#e8b4b8" opacity="0.4"></circle>
    <path d="M45 80C38 78 32 72 30 64M45 110C52 108 58 102 60 94" stroke="#9caf88" stroke-width="1" stroke-linecap="round" opacity="0.35"
    ></path>
  </svg>

  <!-- Bottom right terracotta accent -->
  <svg
    class="floral-bg__flower floral-bg__flower--6"
    viewBox="0 0 100 220"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M50 220C50 175 48 135 50 95C52 55 48 25 50 10"
      stroke="#7a9168"
      stroke-width="1.3"
      stroke-linecap="round"
      opacity="0.45"></path>
    <circle cx="50" cy="8" r="7" fill="#c4846c" opacity="0.4"></circle>
    <circle cx="50" cy="8" r="4" fill="#d4a090" opacity="0.5"></circle>
    <circle cx="46" cy="6" r="2.5" fill="#c4846c" opacity="0.35"></circle>
    <circle cx="54" cy="6" r="2.5" fill="#c4846c" opacity="0.35"></circle>
    <circle cx="50" cy="11" r="2.5" fill="#c4846c" opacity="0.35"></circle>
    <path d="M50 130C42 128 36 122 34 114" stroke="#9caf88" stroke-width="1" stroke-linecap="round" opacity="0.35"
    ></path>
    <ellipse cx="34" cy="114" rx="6" ry="3" fill="#9caf88" opacity="0.28" transform="rotate(-15 34 114)"
    ></ellipse>
  </svg>

  <!-- Soft radial wash for depth -->
  <div class="floral-bg__wash"></div>
</div>

<style>
  .floral-bg__flower {
    position: absolute;
    opacity: 0.85;
  }

  .floral-bg__flower--1 {
    bottom: -2%;
    left: -1%;
    width: min(140px, 22vw);
    height: auto;
  }

  .floral-bg__flower--2 {
    top: 8%;
    right: 2%;
    width: min(90px, 14vw);
    height: auto;
  }

  .floral-bg__flower--3 {
    top: 12%;
    left: 4%;
    width: min(80px, 12vw);
    height: auto;
  }

  .floral-bg__flower--4 {
    bottom: 10%;
    right: -1%;
    width: min(120px, 18vw);
    height: auto;
  }

  .floral-bg__flower--5 {
    top: 45%;
    left: -2%;
    width: min(70px, 10vw);
    height: auto;
    opacity: 0.6;
  }

  .floral-bg__flower--6 {
    bottom: 22%;
    right: 6%;
    width: min(75px, 11vw);
    height: auto;
    opacity: 0.65;
  }

  .floral-bg__wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 0% 100%, rgba(156, 175, 136, 0.06) 0%, transparent 55%),
      radial-gradient(ellipse 60% 40% at 100% 0%, rgba(143, 164, 184, 0.05) 0%, transparent 50%),
      radial-gradient(ellipse 50% 35% at 100% 100%, rgba(196, 132, 108, 0.04) 0%, transparent 45%);
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .floral-bg__flower--5,
    .floral-bg__flower--6 {
      display: none;
    }

    .floral-bg__flower--1,
    .floral-bg__flower--4 {
      opacity: 0.65;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .floral-bg__flower--1 {
      animation: floral-sway 12s ease-in-out infinite;
    }

    .floral-bg__flower--2 {
      animation: floral-sway 10s ease-in-out infinite reverse;
    }

    .floral-bg__flower--4 {
      animation: floral-sway 14s ease-in-out infinite;
      animation-delay: -3s;
    }
  }

  @keyframes floral-sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(1.5deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floral-bg__flower {
      animation: none !important;
    }
  }
</style>
