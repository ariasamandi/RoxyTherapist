---
interface Props {
  variant?: 'pink' | 'lavender' | 'yellow' | 'blue';
  class?: string;
}

const { variant = 'pink', class: className = '' } = Astro.props;
---

<svg
  class:list={['floral-accent', className]}
  viewBox="0 0 60 140"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {
    variant === 'pink' && (
      <>
        <path d="M30 140C30 100 28 60 30 20" stroke="#7a9168" stroke-width="1.2" stroke-linecap="round" opacity="0.55" />
        <path d="M30 80C24 78 20 72 18 66" stroke="#9caf88" stroke-width="1" stroke-linecap="round" opacity="0.45" />
        <circle cx="30" cy="16" r="8" fill="#e8b4b8" opacity="0.65" />
        <circle cx="30" cy="16" r="4.5" fill="#f5d0d4" opacity="0.75" />
        <circle cx="25" cy="13" r="3" fill="#e8b4b8" opacity="0.5" />
        <circle cx="35" cy="13" r="3" fill="#e8b4b8" opacity="0.5" />
        <circle cx="30" cy="20" r="3" fill="#e8b4b8" opacity="0.5" />
      </>
    )
  }
  {
    variant === 'lavender' && (
      <>
        <path d="M30 140C30 100 30 60 30 15" stroke="#7a9168" stroke-width="1.2" stroke-linecap="round" opacity="0.55" />
        <ellipse cx="30" cy="22" rx="4" ry="7" fill="#c9a0dc" opacity="0.6" />
        <ellipse cx="30" cy="36" rx="4" ry="7" fill="#c9a0dc" opacity="0.55" />
        <ellipse cx="30" cy="50" rx="4" ry="6" fill="#c9a0dc" opacity="0.5" />
        <path d="M30 60C26 58 22 54 20 48" stroke="#9caf88" stroke-width="1" stroke-linecap="round" opacity="0.45" />
      </>
    )
  }
  {
    variant === 'yellow' && (
      <>
        <path d="M30 140C30 95 28 55 30 18" stroke="#7a9168" stroke-width="1.2" stroke-linecap="round" opacity="0.55" />
        <circle cx="30" cy="14" r="7" fill="#e8d5a3" opacity="0.65" />
        <circle cx="30" cy="14" r="3.5" fill="#f0e6c8" opacity="0.8" />
        <path d="M30 70C36 68 40 62 42 56" stroke="#9caf88" stroke-width="1" stroke-linecap="round" opacity="0.45" />
      </>
    )
  }
  {
    variant === 'blue' && (
      <>
        <path d="M30 140C30 95 32 55 30 18" stroke="#7a9168" stroke-width="1.2" stroke-linecap="round" opacity="0.55" />
        <circle cx="30" cy="14" r="7.5" fill="#8fa4b8" opacity="0.6" />
        <circle cx="30" cy="14" r="4" fill="#b8c9d9" opacity="0.7" />
        <circle cx="25" cy="12" r="2.5" fill="#8fa4b8" opacity="0.45" />
        <circle cx="35" cy="12" r="2.5" fill="#8fa4b8" opacity="0.45" />
      </>
    )
  }
</svg>

<style>
  .floral-accent {
    width: 56px;
    height: auto;
    opacity: 0.9;
    pointer-events: none;
  }
</style>
