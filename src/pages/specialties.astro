---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site.ts';
import { specialties } from '../content/specialties.ts';
---

<BaseLayout
  title="Specialties"
  description={`${site.name} specializes in anxiety, trauma, self-esteem, relationships, life transitions, and stress. Virtual therapy available.`}
>
  <!-- Hero -->
  <section class="bg-cream">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-24">
      <p class="mb-3 text-sm font-medium uppercase tracking-wider text-sage-dark">Areas of Focus</p>
      <h1 class="text-4xl sm:text-5xl">{specialties.hero.title}</h1>
      <p class="mt-6 text-lg leading-relaxed text-text-muted">{specialties.hero.intro}</p>
    </div>
  </section>

  <!-- Specialty cards -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <ul class="mx-auto grid max-w-5xl gap-8">
      {
        specialties.items.map((item, index) => (
          <li
            class:list={[
              'grid gap-6 rounded-2xl border border-sage/20 p-6 sm:p-8 lg:grid-cols-[1fr_2fr] lg:gap-10',
              index % 2 === 0 ? 'bg-warm-white' : 'bg-cream',
            ]}
          >
            <div>
              <h2 class="text-2xl sm:text-3xl">{item.title}</h2>
              <p class="mt-3 font-medium text-terracotta">{item.outcome}</p>
            </div>
            <p class="leading-relaxed text-text-muted lg:pt-1">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- CTA -->
  <section class="bg-cream">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-24">
      <h2 class="text-3xl sm:text-4xl">{specialties.cta.title}</h2>
      <p class="mt-4 text-lg text-text-muted">{specialties.cta.text}</p>
      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <Button href={site.calendlyUrl} size="lg">
          Schedule a Free 15-Minute Consultation
        </Button>
        <Button href="/services" variant="secondary" size="lg">
          View All Services
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
