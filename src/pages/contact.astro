---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site.ts';
---

<BaseLayout title="Contact">
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <h1 class="text-4xl sm:text-5xl">Contact</h1>
    <p class="mt-6 text-lg text-text-muted">
      Reach out to schedule a consultation or ask a question.
    </p>

    <ul class="mt-10 space-y-4 text-text-muted">
      <li>
        <span class="font-medium text-text">Phone:</span>
        <a href={`tel:${site.contact.phoneHref}`} class="ml-2 hover:text-terracotta">
          {site.contact.phone}
        </a>
      </li>
      <li>
        <span class="font-medium text-text">Email:</span>
        <a href={`mailto:${site.contact.email}`} class="ml-2 hover:text-terracotta">
          {site.contact.email}
        </a>
      </li>
      <li>
        <span class="font-medium text-text">Location:</span>
        <span class="ml-2">{site.contact.location}</span>
      </li>
    </ul>

    <div class="mt-10">
      <Button href={site.calendlyUrl} size="lg">
        {site.cta.label}
      </Button>
    </div>
  </section>
</BaseLayout>
