---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import FloralAccent from '../components/FloralAccent.astro';
import { site } from '../config/site.ts';
import { about } from '../content/about.ts';
---

<BaseLayout
  title="About"
  description={`Learn about ${site.name} — background, approach, and what to expect from virtual therapy.`}
>
  <!-- Hero -->
  <section class="surface-cream relative overflow-hidden">
    <FloralAccent variant="lavender" class="absolute right-6 top-10 hidden sm:block" />
    <div class="relative mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div class="relative order-2 lg:order-1 lg:mx-auto lg:w-full lg:max-w-md">
        <FloralAccent variant="pink" class="absolute -left-6 bottom-10 z-0 hidden sm:block" />
        <div
          class="surface-photo relative z-10 flex aspect-[3/4] items-center justify-center rounded-2xl"
          role="img"
          aria-label="Professional photo of Roxy Mandisen"
        >
          <p class="px-6 text-center text-sm text-text-muted">Professional photo</p>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <p class="mb-3 text-sm font-medium uppercase tracking-wider text-sage-dark">About Me</p>
        <h1 class="text-4xl leading-tight sm:text-5xl">{about.hero.greeting}</h1>
        <p class="mt-6 text-lg leading-relaxed text-text-muted">{about.hero.intro}</p>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="text-3xl sm:text-4xl">{about.story.title}</h2>
    <div class="mt-6 space-y-5 text-lg leading-relaxed text-text-muted">
      {about.story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <!-- Why therapy -->
  <section class="surface-cream">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="text-3xl sm:text-4xl">{about.whyTherapy.title}</h2>
      <div class="mt-6 space-y-5 text-lg leading-relaxed text-text-muted">
        {about.whyTherapy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="text-3xl sm:text-4xl">{about.philosophy.title}</h2>
    <p class="mt-6 text-lg leading-relaxed text-text-muted">{about.philosophy.intro}</p>

    <ul class="mt-8 space-y-4">
      {
        about.philosophy.points.map((point) => (
          <li class="flex gap-3 text-lg text-text-muted">
            <span class="mt-1 shrink-0 text-sage" aria-hidden="true">✓</span>
            <span>{point}</span>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-lg leading-relaxed text-text-muted">{about.philosophy.closing}</p>
  </section>

  <!-- Personal details -->
  <section class="surface-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl sm:text-4xl">{about.personal.title}</h2>
        <p class="mt-4 text-lg text-text-muted">{about.personal.intro}</p>
      </div>

      <ul class="mx-auto mt-12 grid max-w-4xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          about.personal.interests.map((interest) => (
            <li class="surface-card rounded-2xl border border-sage/20 p-6">
              <h3 class="text-xl">{interest.label}</h3>
              <p class="mt-2 text-text-muted">{interest.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-24">
    <h2 class="text-3xl sm:text-4xl">{about.cta.title}</h2>
    <p class="mt-4 text-lg text-text-muted">{about.cta.text}</p>
    <div class="mt-8">
      <Button href={site.calendlyUrl} size="lg">
        Schedule a Free 15-Minute Consultation
      </Button>
    </div>
  </section>
</BaseLayout>
