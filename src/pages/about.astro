---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import FloralAccent from '../components/FloralAccent.astro';
import { site } from '../config/site.ts';
import { about } from '../content/about.ts';
import { roxyPhoto } from '../content/home.ts';
---

<BaseLayout
  title="About"
  description={`Learn about ${site.name} — background, approach, and what to expect from virtual therapy.`}
>
  <!-- Hero -->
  <section class="surface-cream relative overflow-hidden">
    <h1 class="sr-only">About Me</h1>
    <FloralAccent variant="lavender" class="absolute right-6 top-10 hidden sm:block" />
    <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
      <div class="relative mx-auto w-full max-w-md">
        <FloralAccent variant="pink" class="absolute -left-6 bottom-10 z-0 hidden sm:block" />
        <div class="surface-photo relative z-10 aspect-[2/3] overflow-hidden rounded-2xl">
          <img
            src={roxyPhoto.src}
            alt={roxyPhoto.alt}
            class="h-full w-full object-cover object-[center_20%]"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="text-3xl sm:text-4xl">{about.story.title}</h2>
    <div class="mt-6 space-y-5 text-lg leading-relaxed text-text-muted">
      {about.story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <!-- Why therapy -->
  <section class="surface-cream">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="text-3xl sm:text-4xl">{about.whyTherapy.title}</h2>
      <div class="mt-6 space-y-5 text-lg leading-relaxed text-text-muted">
        {about.whyTherapy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <!-- Personal details -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl sm:text-4xl">{about.personal.title}</h2>
      <p class="mt-4 text-lg text-text-muted">{about.personal.intro}</p>
    </div>

    <ul class="mx-auto mt-12 grid max-w-4xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        about.personal.interests.map((interest) => (
          <li class="surface-card rounded-2xl border border-sage/20 p-6">
            <h3 class="text-xl">{interest.label}</h3>
            <p class="mt-2 text-text-muted">{interest.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- CTA -->
  <section class="surface-cream">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-24">
      <h2 class="text-3xl sm:text-4xl">{about.cta.title}</h2>
      <p class="mt-4 text-lg text-text-muted">{about.cta.text}</p>
      <div class="mt-8">
        <Button href={site.calendlyUrl} size="lg">
          Schedule a Free 15-Minute Consultation
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
