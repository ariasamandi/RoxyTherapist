---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site.ts';
---

<BaseLayout>
  <section class="relative overflow-hidden bg-cream">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:items-center lg:py-28">
      <div>
        <p class="mb-4 text-sm font-medium uppercase tracking-wider text-sage-dark">
          Virtual Therapy
        </p>
        <h1 class="text-4xl leading-tight sm:text-5xl lg:text-6xl">
          {site.tagline}
        </h1>
        <p class="mt-6 max-w-xl text-lg text-text-muted">
          Therapy for individuals and couples ready to create meaningful change.
        </p>
        <div class="mt-8">
          <Button href={site.calendlyUrl} size="lg">
            Schedule a Free 15-Minute Consultation
          </Button>
        </div>
      </div>

      <div
        class="flex aspect-[4/3] items-center justify-center rounded-2xl bg-dusty-blue/20 text-text-muted"
        aria-hidden="true"
      >
        <p class="px-6 text-center text-sm">Hero image placeholder</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="text-center text-text-muted">
      Home page sections coming next — intro, how I can help, approach, process, and CTA.
    </p>
  </section>
</BaseLayout>
